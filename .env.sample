# Filter for debug logs. All Safenet related logs are under the `safenet:`
# prefix, but additional filtering can be specified in case more specific logs
# are desired.
DEBUG=safenet,safenet:*

# The SQLite database file to use for storing indexed events. This allows data
# that is queried from the chain to be cached between runs.
DATABASE_FILE=:memory:

# The RPC URL to use for Safenet staking.
STAKING_RPC_URL=https://mainnet.gateway.tenderly.co
# The number of blocks to fetch logs for at a time on the staking chain.
STAKING_BLOCK_PAGE_SIZE=100
# The address of the staking contract.
STAKING_ADDRESS=0x115E78f160e1E3eF163B05C84562Fa16fA338509
# The block where the staking contract was deployed.
STAKING_START_BLOCK=24585750
# The address of the delegate registry which we use to allow validator stakers
# to signal different beneficiary addresses for their commission.
DELEGATE_REGISTRY_ADDRESS=0x469788fE6E9E9681C6ebF3bF78e7Fd26Fc015446
# The starting block of the delegate registry.
DELEGATE_REGISTRY_START_BLOCK=11225329
# The address of the Chainanalysis sanctions list oracle.
SANCTIONS_LIST_ADDRESS=0x40C57923924B5c5c5455c48D93317139ADDaC8fb
# The starting block of the Chainanalysis sanctions list.
SANCTIONS_LIST_START_BLOCK=14356508
# The `owner/name` GitHub repository whose `latest` release the UN, EU, UK,
# Swiss SECO and US OFAC address lists are fetched from. Lists pinned to a
# period come from its dated `data-YYYY-MM-DD` snapshot releases instead.
# Optional; defaults to <https://github.com/safe-fndn/sanctions-address-lists>
# if unset.
# SANCTIONS_ADDRESS_REPO=safe-fndn/sanctions-address-lists
# A GitHub token for listing the sanctions address lists releases. Optional;
# unauthenticated GitHub API requests are limited to 60 an hour per IP, which
# shared CI runners can exhaust. GitHub Actions provides one.
# GITHUB_TOKEN=
# The IPFS trustless gateway that the CAR of the previous rewards DB is fetched
# from (as `<gateway>/ipfs/<cid>?format=car`). The CAR is verified against the
# CID that the ENS `contenthash` pins, so the gateway does not need to be
# trusted. Used by `cmd:export`. Optional; defaults to the gateway of a local
# Kubo node if unset.
# IPFS_GATEWAY_URL=http://127.0.0.1:8080
# The address of the cumulative Merkle drop contract for payouts.
CUMULATIVE_MERKLE_DROP_ADDRESS=0xe5139Fc0FB8eae81e30d8a85C22E88c6757120f2
# The Zodiac Reality Module on the Governance Safe, which distributions are
# proposed to. Everything else about governance (the Safe, the Reality.eth
# oracle, the question template, bond and timings) is read from it. Used by
# `cmd:export`.
REALITY_MODULE_ADDRESS=0x8DFc5Db2C83200Cf0cC84d7e3C441d7721ef83dC
# The ENS name whose `contenthash` pins the latest rewards DB. Used by
# `cmd:export`.
REWARDS_ENS_NAME=rewards.safenet-gov.eth

# The RPC URL to use for Safenet consensus.
CONSENSUS_RPC_URL=https://gnosis.gateway.tenderly.co
# The number of blocks to fetch logs for at a time on the staking chain.
CONSENSUS_BLOCK_PAGE_SIZE=25
# The address of the consensus contract.
CONSENSUS_ADDRESS=0x223624cBF099e5a8f8cD5aF22aFa424a1d1acEE9
# The block where consensus begun; in the beta this was the block where the
# consensus contract was deployed on. This allows us to disregard blocks before
# this and speed up event indexing.
CONSENSUS_START_BLOCK=45210396
# The address of the sentinel oracle contract that sentinel participation is
# indexed from. The oracle lives on the consensus chain, so it uses
# `CONSENSUS_RPC_URL`. TODO: this is a placeholder and must be replaced with
# the deployed address before the first production run.
SENTINEL_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
# The block where the sentinel oracle was deployed. TODO: placeholder, see
# above; indexing from the consensus start block is correct but wasteful once
# the real deployment block is known.
SENTINEL_ORACLE_START_BLOCK=45210396
